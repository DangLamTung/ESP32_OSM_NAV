# ESP-IDF build artifacts
/build/
/sdkconfig
/sdkconfig.old
/dependencies.lock

# ESP-IDF managed components (generated by idf.py / idf_component.yml)
# NOTE: vendored components under /components/ are committed intentionally
/managed_components/

# Local secrets (WiFi credentials) - never commit
/src/secrets.h

# Downloaded tile data (large, regenerable)
/tiles/
/tiles_hcmc/
/tiles_z15test/

# Build/preview scratch
/preview/

# OS / editor
.DS_Store
Thumbs.db
# local VS Code workspace config (machine-specific tasks/settings) — keep out
.vscode/
# clangd / editor index cache (was accidentally committed once — keep out)
.cache/
# stray background logs
nohup.out

# large routing graph binaries (rebuilt via tools/)
tools/graphs/*.rng
